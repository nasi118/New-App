# Set these in the process or hosting environment. This server does not load .env files automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Required for AI requests outside direct localhost; enter this separate app token in Advisor Settings.
ADVISOR_ACCESS_TOKEN=
# Public Google OAuth web client ID for each user's Sheets connection.
# See docs/planner-google-sheets.md for consent-screen and origin setup.
GOOGLE_CLIENT_ID=
# Optional existing AI Tax Reviewer and Optimizer provider.
XAI_API_KEY=
PORT=3000
